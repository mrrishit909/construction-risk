 "components": {
  "schemas": {
   "BimElement": {
    "properties": {
     "guid": {
      "type": "string",
      "maxLength": 60,
      "title": "Guid"
     },
     "element_type": {
      "type": "string",
      "maxLength": 40,
      "title": "Element Type"
     },
     "level": {
      "type": "string",
      "maxLength": 10,
      "title": "Level"
     },
     "activity_external_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Activity External Id"
     },
     "geom_ref": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Geom Ref"
     }
    },
    "type": "object",
    "required": [
     "guid",
     "element_type",
     "level"
    ],
    "title": "BimElement"
   },
   "BimIn": {
    "properties": {
     "source": {
      "type": "string",
      "maxLength": 40,
      "title": "Source",
      "default": "IFC export"
     },
     "elements": {
      "items": {
       "$ref": "#/components/schemas/BimElement"
      },
      "type": "array",
      "maxItems": 5000,
      "minItems": 1,
      "title": "Elements"
     }
    },
    "type": "object",
    "required": [
     "elements"
    ],
    "title": "BimIn"
   },
   "ChangeOrderIn": {
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 3,
      "title": "Title"
     },
     "amount": {
      "type": "number",
      "maximum": 50000000.0,
      "minimum": 0.0,
      "title": "Amount"
     },
     "requested_days": {
      "type": "integer",
      "maximum": 365.0,
      "minimum": 0.0,
      "title": "Requested Days"
     },
     "cause": {
      "type": "string",
      "enum": [
       "owner change",
       "design error",
       "site condition",
       "weather",
       "supplier"
      ],
      "title": "Cause"
     },
     "scope": {
      "additionalProperties": true,
      "type": "object",
      "title": "Scope",
      "description": "{trade: extra days per remaining activity} and/or {activity_external_id: extra days}"
     }
    },
    "type": "object",
    "required": [
     "title",
     "amount",
     "requested_days",
     "cause",
     "scope"
    ],
    "title": "ChangeOrderIn"
   },
   "Event": {
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "procurement_delay",
       "weather"
      ],
      "title": "Kind"
     },
     "item": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Item"
     },
     "expected_day": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 1000.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Expected Day"
     },
     "from_day": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 1000.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "From Day"
     },
     "to_day": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 1000.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "To Day"
     }
    },
    "type": "object",
    "required": [
     "kind"
    ],
    "title": "Event"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 17
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "PhotoIn": {
    "properties": {
     "activity_external_id": {
      "type": "string",
      "pattern": "^A\\d{4}$",
      "title": "Activity External Id"
     },
     "captured_at": {
      "type": "string",
      "format": "date-time",
      "title": "Captured At"
     },
     "png_base64": {
      "type": "string",
      "maxLength": 2000000,
      "minLength": 100,
      "title": "Png Base64"
     }
    },
    "type": "object",
    "required": [
     "activity_external_id",
     "captured_at",
     "png_base64"
    ],
    "title": "PhotoIn"
   },
   "ScenarioIn": {
    "properties": {
     "events": {
      "items": {
       "$ref": "#/components/schemas/Event"
      },
      "type": "array",
      "maxItems": 5,
      "minItems": 1,
      "title": "Events"
     },
     "apply": {
      "type": "boolean",
      "title": "Apply",
      "description": "Record the events as announced, so every forecast from now on includes them",
      "default": false
     },
     "runs": {
      "type": "integer",
      "maximum": 5000.0,
      "minimum": 100.0,
      "title": "Runs",
      "default": 1000
     }
    },
    "type": "object",
    "required": [
     "events"
    ],
    "title": "ScenarioIn"
   },
   "ScheduleIn": {
    "properties": {
     "source": {
      "type": "string",
      "maxLength": 40,
      "title": "Source",
      "default": "P6 export"
     },
     "activities": {
      "items": {
       "$ref": "#/components/schemas/ScheduleRow"
      },
      "type": "array",
      "maxItems": 600,
      "minItems": 1,
      "title": "Activities"
     }
    },
    "type": "object",
    "required": [
     "activities"
    ],
    "title": "ScheduleIn"
   },
   "ScheduleRow": {
    "properties": {
     "external_id": {
      "type": "string",
      "pattern": "^A\\d{4}$",
      "title": "External Id"
     },
     "percent_complete": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Percent Complete"
     },
     "actual_start": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "Actual Start"
     },
     "actual_end": {
      "anyOf": [
       {
        "type": "string",
        "format": "date"
       },
       {
        "type": "null"
       }
      ],
      "title": "Actual End"
     }
    },
    "type": "object",
    "required": [
     "external_id",
     "percent_complete"
    ],
    "title": "ScheduleRow"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}